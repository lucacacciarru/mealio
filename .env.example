# Local-only values. Keep real values in Railway variables in production.
DATABASE_PATH=./data/mealio.sqlite
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_PASSWORD_HASH=generate-with-pnpm-auth-hash
BACKUP_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# Set a Gemini API key locally to enable explicitly authorized PDF extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ams
