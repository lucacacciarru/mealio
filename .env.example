# Local-only values. Keep real values in Railway variables in production.
DATABASE_PATH=./data/mealio.sqlite
# The password is chosen in the app on first open. Optional overrides:
# ADMIN_PASSWORD_HASH=output-of-pnpm-auth-hash
# SESSION_SECRET=at-least-32-random-bytes
BACKUP_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# Set an OpenRouter API key locally to enable PDF analysis.
OPENROUTER_API_KEY=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ams
