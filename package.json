{
  "name": "mealio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build && tsc --noEmit",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "start:deploy": "pnpm db:migrate && pnpm start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "auth:hash": "tsx scripts/hash-password.ts",
    "backup:run": "node --env-file-if-exists=.env scripts/maintenance-cli.mjs backup",
    "export:run": "node --env-file-if-exists=.env scripts/maintenance-cli.mjs export",
    "backup:restore": "node --env-file-if-exists=.env scripts/restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.260903-beta",
    "railway": "3.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
